# --- AI SERVICES (FREE TIER) ---
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# --- DATABASE (FREE TIER) ---
# SQLite is a local file-based database (No server needed)
# For Neon/Supabase Postgres, use: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="sqlite:///./mediassist.db"

# --- VOICE SERVICES (OPTIONAL/PAID) ---
# Only fill these if you want to use real phone calls later
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="your_twilio_phone_number"

# --- SECURITY ---
# Secret key for JWT token signing. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# WARNING: If not set, a random key is generated on each restart (all tokens get invalidated on restart)
SECRET_KEY="your_secret_key_here"

# Encryption key for sensitive data (phone numbers). Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If you lose this key, all encrypted phone numbers become unrecoverable
ENCRYPTION_KEY=""

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS="https://medi-assist-01.vercel.app,http://localhost:3000"

# JWT token expiration in minutes (default: 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60